meta {
  name: 05 Eliminar categoria
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/categoria/eliminar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": {{categoriaTempId}}
  }
}

script:pre-request {
  const id = Number(bru.getEnvVar("categoriaTempId"));
  if (!Number.isInteger(id) || id <= 1) { throw new Error("Usar exclusivamente el ID temporal de esta sesion."); }
}

tests {
  test("HTTP 204", function () { expect(res.status).to.equal(204); });
}

docs {
  Seleccionar Local. No ejecutar toda la coleccion; seguir CRUD_CATALOGO.md.
}
