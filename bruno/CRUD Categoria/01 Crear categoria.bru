meta {
  name: 01 Crear categoria
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/categoria/agregar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "TEMP Catalogo 021126 A"
  }
}

script:post-response {
  if (res.status === 201) { bru.setEnvVar("categoriaTempId", res.body.id); }
}

tests {
  test("HTTP 201", function () { expect(res.status).to.equal(201); });
}

docs {
  Seleccionar Local. No ejecutar toda la coleccion; seguir CRUD_CATALOGO.md.
}
