meta {
  name: 04 Modificar categoria
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/categoria/modificar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": {{categoriaTempId}},
    "nombre": "TEMP Catalogo 021126 A editada"
  }
}

script:pre-request {
  const id = Number(bru.getEnvVar("categoriaTempId"));
  if (!Number.isInteger(id) || id <= 1) { throw new Error("Usar exclusivamente el ID temporal de esta sesion."); }
}

tests {
  test("HTTP 200", function () { expect(res.status).to.equal(200); });
}

docs {
  Seleccionar Local. No ejecutar toda la coleccion; seguir CRUD_CATALOGO.md.
}
