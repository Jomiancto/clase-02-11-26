meta {
  name: 02 Crear cliente
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/clientes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Cliente de clase",
    "email": "clase-02-11-2026@example.test"
  }
}

script:post-response {
  if (res.status === 201) { bru.setEnvVar("clienteId", res.body.id); }
}

tests {
  test("Creado HTTP 201", function () { expect(res.status).to.equal(201); });
}

docs {
  Ejecutar una sola vez en orden. Repetir POST puede duplicar registros.
  Categoria y email son unicos. GET permite comprobar lo que ya existe.
}
