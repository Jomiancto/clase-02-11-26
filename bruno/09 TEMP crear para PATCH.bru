meta {
  name: 09 TEMP crear para PATCH
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/clientes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Temporal PATCH CRUD",
    "email": "crud-temp-patch-021126@example.test"
  }
}

script:post-response {
  if (res.status === 201) { bru.setEnvVar("clientePatchId", res.body.id); }
}

tests {
  test("HTTP 201", function () { expect(res.status).to.equal(201); });
}

docs {
  Prueba controlada con clientes temporales. No utilizar ID 1.
  Preparar/verificar la sesion con tools/verificar_update_delete.py desde Cmder.
}
