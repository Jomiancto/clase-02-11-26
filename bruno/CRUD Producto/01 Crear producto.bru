meta {
  name: 01 Crear producto
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/producto/agregar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "TEMP Producto",
    "descripcion": "Prueba controlada",
    "precio": 2500,
    "stock": 4,
    "activo": true,
    "codigo": "TEMP-CAT-021126",
    "categorias": [
      {{categoriaTempId}}
    ]
  }
}

script:post-response {
  if (res.status === 201) { bru.setEnvVar("productoTempId", res.body.id); }
}

tests {
  test("HTTP 201", function () { expect(res.status).to.equal(201); });
}

docs {
  Seleccionar Local. No ejecutar toda la coleccion; seguir CRUD_CATALOGO.md.
}
