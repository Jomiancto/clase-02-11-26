meta {
  name: 05 Eliminar producto
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/producto/eliminar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": {{productoTempId}}
  }
}

script:pre-request {
  const id = Number(bru.getEnvVar("productoTempId"));
  if (!Number.isInteger(id) || id <= 1) { throw new Error("Usar exclusivamente el ID temporal de esta sesion."); }
}

tests {
  test("HTTP 204", function () { expect(res.status).to.equal(204); });
}

docs {
  Seleccionar Local. No ejecutar toda la coleccion; seguir CRUD_CATALOGO.md.
}
